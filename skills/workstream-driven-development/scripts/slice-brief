#!/usr/bin/env bash
# Extract one slice's full text from a Workstream Document into a file the
# implementer reads in one call, so the slice text never has to be pasted
# through the controller's context.
#
# Usage: slice-brief WORKSTREAM_FILE SLICE_ID [SLUG_OVERRIDE]
# Default output: .solopowers/wsd/<slug>/slice-<ID>-brief.md
# slug is auto-derived from the workstream filename (date prefix stripped)
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: slice-brief WORKSTREAM_FILE SLICE_ID [SLUG_OVERRIDE]" >&2
  exit 2
fi

workstream=$1
slice_id=$2
if [[ ! "$slice_id" =~ ^[A-Z][0-9]*$ ]]; then
  echo "invalid slice ID: ${slice_id} (expected an uppercase letter followed by zero or more digits)" >&2
  exit 2
fi

[ -f "$workstream" ] || {
  echo "no such workstream file: $workstream" >&2
  exit 2
}

# Derive slug from filename: strip directory, .md extension, and leading YYYY-MM-DD-
if [ $# -eq 3 ] && [ -n "$3" ]; then
  slug=$3
else
  slug=$(basename "$workstream" .md | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//')
fi

dir=$("${BASH_SOURCE[0]%/*}/wsd-workspace" "$slug")
out="$dir/slice-${slice_id}-brief.md"

awk -v requested="$slice_id" '
  function delimiter_run(line, start, marker,    run) {
    run = 0
    while (substr(line, start + run, 1) == marker) run++
    return run
  }
  {
    indent = 0
    while (substr($0, indent + 1, 1) == " ") indent++
    marker = substr($0, indent + 1, 1)
    if (indent <= 3 && (marker == "`" || marker == "~")) {
      run = delimiter_run($0, indent + 1, marker)
      if (run >= 3) {
        remainder = substr($0, indent + 1 + run)
        if (infence) {
          if (marker == fence_marker && run >= fence_length && remainder ~ /^[[:space:]]*$/) {
            infence = 0
            fence_marker = ""
            fence_length = 0
          }
          if (inslice) print
          next
        }
        if (marker == "~" || remainder !~ /`/) {
          infence = 1
          fence_marker = marker
          fence_length = run
          if (inslice) print
          next
        }
      }
    }
    if (infence) {
      if (inslice) print
      next
    }
    if (/^###[[:space:]]+Slice[[:space:]]+[A-Z][0-9]*:/) {
      heading = $0
      sub(/^###[[:space:]]+Slice[[:space:]]+/, "", heading)
      sub(/:.*/, "", heading)
      if (inslice) exit
      inslice = (heading == requested)
    }
    if (inslice) print
  }
' "$workstream" > "$out"

if [ ! -s "$out" ]; then
  echo "slice ${slice_id} not found in ${workstream} (no heading matching '### Slice ${slice_id}:')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines (workspace: ${slug})"
