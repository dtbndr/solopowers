#!/usr/bin/env bash
# Extract one slice's full text from a Workstream Document (the slices.md of a
# workstream folder docs/workstreams/YYYY-MM-DD-<topic>/, or a single
# workstream .md file) into a file the
# implementer reads in one call, so the slice text never has to be pasted
# through the controller's context.
#
# Usage: slice-brief WORKSTREAM_FILE SLICE_ID [SLUG_OVERRIDE]
# Default output: .solopowers/wsd/<slug>/slice-<ID>-brief.md
# The slug is derived by wsd-workspace: from the workstream filename (date
# prefix stripped), or from the parent folder name when the file is slices.md.
# An explicit SLUG_OVERRIDE wins.
#
# Exit codes: 0 brief written; 2 usage error; 3 slice not found;
# 4 an unclosed code fence hides a later Slice heading while the requested
# slice is captured, so its end cannot be found (the partial brief is removed).
#
# A fence that never closes hides every Slice heading after it. When it hides
# one while the requested slice is being captured, the brief would run on
# through every later slice: refuse (exit 4) rather than hand an implementer
# several slices as its requirements. When it hides the requested heading
# itself, say so before the not-found error (exit 3). A stray unclosed fence
# that hides no Slice heading (a document may end with a lone ``` line) leaves
# the brief complete, so brief it with a warning. The workstream path goes
# through ENVIRON, not -v, which would mangle backslashes.
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: slice-brief WORKSTREAM_FILE SLICE_ID [SLUG_OVERRIDE]" >&2
  exit 2
fi

workstream=$1
slice_id=$2
if [[ ! "$slice_id" =~ ^[A-Z][0-9]*$ ]]; then
  echo "invalid slice ID: ${slice_id} (expected an uppercase letter followed by zero or more digits)" >&2
  exit 2
fi

[ -f "$workstream" ] || {
  echo "no such workstream file: $workstream" >&2
  exit 2
}

slug=""
if [ $# -eq 3 ] && [ -n "$3" ]; then
  slug=$3
fi

# Invoke via bash rather than direct exec: some extractors (Python zipfile)
# strip Unix exec bits when unpacking marketplace packages (#2040).
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ -n "$slug" ]; then
  dir=$("${BASH:-bash}" "$here/wsd-workspace" "$slug" "$workstream")
else
  dir=$("${BASH:-bash}" "$here/wsd-workspace" "$workstream")
fi
out="$dir/slice-${slice_id}-brief.md"

rc=0
SLICE_BRIEF_WS="$workstream" awk -v requested="$slice_id" '
  function delimiter_run(line, start, marker,    run) {
    run = 0
    while (substr(line, start + run, 1) == marker) run++
    return run
  }
  {
    indent = 0
    while (substr($0, indent + 1, 1) == " ") indent++
    marker = substr($0, indent + 1, 1)
    if (indent <= 3 && (marker == "`" || marker == "~")) {
      run = delimiter_run($0, indent + 1, marker)
      if (run >= 3) {
        remainder = substr($0, indent + 1 + run)
        if (infence) {
          if (marker == fence_marker && run >= fence_length && remainder ~ /^[[:space:]]*$/) {
            infence = 0
            fence_marker = ""
            fence_length = 0
          }
          if (inslice) print
          next
        }
        if (marker == "~" || remainder !~ /`/) {
          infence = 1
          fence_marker = marker
          fence_length = run
          fence_line = NR
          hidden = 0
          if (inslice) print
          next
        }
      }
    }
    if (infence) {
      if (/^###[[:space:]]+Slice[[:space:]]+[A-Z][0-9]*:/) hidden = 1
      if (inslice) print
      next
    }
    if (/^###[[:space:]]+Slice[[:space:]]+[A-Z][0-9]*:/) {
      heading = $0
      sub(/^###[[:space:]]+Slice[[:space:]]+/, "", heading)
      sub(/:.*/, "", heading)
      if (inslice) exit
      inslice = (heading == requested)
    }
    if (inslice) print
    found = found || inslice
  }
  END {
    where = "the code fence opened at line " fence_line " of " ENVIRON["SLICE_BRIEF_WS"] " never closes"
    if (infence && hidden && (inslice || !found)) {
      print "slice-brief: " where ", so no Slice heading after it can be seen; close that fence in the workstream and rerun" | "cat >&2"
      if (inslice) exit 4
    } else if (infence && inslice) {
      print "slice-brief: warning: " where "; it hides no Slice heading, so this brief is complete" | "cat >&2"
    }
  }
' "$workstream" > "$out" || rc=$?
if [ "$rc" -ne 0 ]; then
  rm -f "$out"
  exit "$rc"
fi

if [ ! -s "$out" ]; then
  echo "slice ${slice_id} not found in ${workstream} (no heading matching '### Slice ${slice_id}:')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines (workspace: $(basename "$dir"))"
