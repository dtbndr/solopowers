#!/usr/bin/env bash
# Integration tests for slice-brief slice-ID parsing and section boundaries.
set -euo pipefail

base=$(cd "${BASH_SOURCE[0]%/*}" && pwd)
slice_brief="$base/slice-brief"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}
expect_exit() {
  expected=$1
  shift
  if "$@" >/dev/null 2>&1; then
    status=0
  else
    status=$?
  fi
  [ "$status" -eq "$expected" ] || fail "expected exit $expected, got $status: $*"
}

cd "$tmp"
git init -q repo
git -C repo config user.email test@example.invalid
git -C repo config user.name test
mkdir -p repo/docs/workstreams
cat > repo/docs/workstreams/2026-01-01-slice-ids.md <<'EOF'
# Slice ID test workstream

### Slice A: Legacy slice

legacy-body

```
### Slice F: Fenced heading must not be a boundary
fenced-body
```

### Slice A1: First numbered slice

first-numbered-body

### Slice A2: Second numbered slice

second-numbered-body

### Slice B: Following legacy slice

following-body

### Slice C: Tilde-fenced example

tilde-before

~~~markdown
### Slice C1: Tilde-fenced duplicate
fake-tilde-body
~~~

tilde-after

### Slice C1: Actual tilde-numbered slice

tilde-real-body

### Slice D: Indented-backtick example

backtick-before

   ```markdown
### Slice D1: Indented-backtick duplicate
fake-backtick-body
   ```

backtick-after

### Slice D1: Actual backtick-numbered slice

backtick-real-body

### Slice E: Invalid backtick pseudo-opener

invalid-opener-before
```lang`bad
### Slice E1: Actual slice after invalid pseudo-opener
invalid-opener-real-body
EOF

git -C repo add .
git -C repo commit -qm initial
workstream="$tmp/repo/docs/workstreams/2026-01-01-slice-ids.md"
workspace="$tmp/repo/.solopowers/wsd/slice-ids"
cd "$tmp/repo"

brief_a=$($slice_brief "$workstream" A)
[ -f "$workspace/slice-A-brief.md" ] || fail "legacy brief missing"
grep -q '^### Slice A: Legacy slice$' "$workspace/slice-A-brief.md" || fail "legacy heading missing"
grep -q '^legacy-body$' "$workspace/slice-A-brief.md" || fail "legacy body missing"
! grep -q 'Slice A1\|Slice A2\|following-body' "$workspace/slice-A-brief.md" || fail "legacy brief crossed a boundary"
grep -q '^### Slice F: Fenced heading must not be a boundary$' "$workspace/slice-A-brief.md" || fail "fenced heading was not preserved"
grep -q '^fenced-body$' "$workspace/slice-A-brief.md" || fail "fenced body was not preserved"
grep -q '^```$' "$workspace/slice-A-brief.md" || fail "fenced delimiters were not preserved"
[[ "$brief_a" == *"slice-A-brief.md"* ]] || fail "legacy output path missing"

brief_a1=$($slice_brief "$workstream" A1)
[ -f "$workspace/slice-A1-brief.md" ] || fail "A1 brief missing"
grep -q '^### Slice A1: First numbered slice$' "$workspace/slice-A1-brief.md" || fail "A1 heading missing"
grep -q '^first-numbered-body$' "$workspace/slice-A1-brief.md" || fail "A1 body missing"
! grep -q 'Slice A2\|second-numbered-body\|following-body' "$workspace/slice-A1-brief.md" || fail "A1 brief crossed a boundary"
[[ "$brief_a1" == *"slice-A1-brief.md"* ]] || fail "A1 output path missing"

brief_a2=$($slice_brief "$workstream" A2)
[ -f "$workspace/slice-A2-brief.md" ] || fail "A2 brief missing"
grep -q '^### Slice A2: Second numbered slice$' "$workspace/slice-A2-brief.md" || fail "A2 heading missing"
grep -q '^second-numbered-body$' "$workspace/slice-A2-brief.md" || fail "A2 body missing"
! grep -q 'Slice B\|following-body' "$workspace/slice-A2-brief.md" || fail "A2 brief crossed a boundary"
[[ "$brief_a2" == *"slice-A2-brief.md"* ]] || fail "A2 output path missing"

$slice_brief "$workstream" C >/dev/null
grep -q '^### Slice C1: Tilde-fenced duplicate$' "$workspace/slice-C-brief.md" || fail "tilde heading was not preserved"
grep -q '^fake-tilde-body$' "$workspace/slice-C-brief.md" || fail "tilde fenced body was not preserved"
grep -q '^~~~markdown$' "$workspace/slice-C-brief.md" || fail "tilde opening fence was not preserved"
grep -q '^~~~$' "$workspace/slice-C-brief.md" || fail "tilde closing fence was not preserved"
grep -q '^tilde-before$' "$workspace/slice-C-brief.md" || fail "tilde slice lost preceding body"
grep -q '^tilde-after$' "$workspace/slice-C-brief.md" || fail "tilde slice lost following body"
! grep -q '^### Slice C1: Actual tilde-numbered slice$' "$workspace/slice-C-brief.md" || fail "tilde real slice crossed a boundary"

$slice_brief "$workstream" C1 >/dev/null
grep -q '^### Slice C1: Actual tilde-numbered slice$' "$workspace/slice-C1-brief.md" || fail "tilde C1 selected fenced duplicate"
grep -q '^tilde-real-body$' "$workspace/slice-C1-brief.md" || fail "actual tilde C1 body missing"
! grep -q 'fake-tilde-body' "$workspace/slice-C1-brief.md" || fail "tilde C1 brief included fenced body"

$slice_brief "$workstream" D >/dev/null
grep -q '^### Slice D1: Indented-backtick duplicate$' "$workspace/slice-D-brief.md" || fail "indented backtick heading was not preserved"
grep -q '^fake-backtick-body$' "$workspace/slice-D-brief.md" || fail "indented backtick body was not preserved"
grep -q '^   ```markdown$' "$workspace/slice-D-brief.md" || fail "indented opening fence was not preserved"
grep -q '^   ```$' "$workspace/slice-D-brief.md" || fail "indented closing fence was not preserved"
grep -q '^backtick-before$' "$workspace/slice-D-brief.md" || fail "backtick slice lost preceding body"
grep -q '^backtick-after$' "$workspace/slice-D-brief.md" || fail "backtick slice lost following body"
! grep -q '^### Slice D1: Actual backtick-numbered slice$' "$workspace/slice-D-brief.md" || fail "backtick real slice crossed a boundary"

$slice_brief "$workstream" D1 >/dev/null
grep -q '^### Slice D1: Actual backtick-numbered slice$' "$workspace/slice-D1-brief.md" || fail "backtick D1 selected fenced duplicate"
grep -q '^backtick-real-body$' "$workspace/slice-D1-brief.md" || fail "actual backtick D1 body missing"
! grep -q 'fake-backtick-body' "$workspace/slice-D1-brief.md" || fail "backtick D1 brief included fenced body"

$slice_brief "$workstream" E1 >/dev/null
grep -q '^### Slice E1: Actual slice after invalid pseudo-opener$' "$workspace/slice-E1-brief.md" || fail "invalid backtick pseudo-opener hid real slice"
grep -q '^invalid-opener-real-body$' "$workspace/slice-E1-brief.md" || fail "slice after invalid pseudo-opener body missing"

expect_exit 2 "$slice_brief" "$workstream" A-1
expect_exit 2 "$slice_brief" "$workstream" A/1
[ ! -e "$workspace/slice-A-1-brief.md" ] || fail "invalid ID created an output"
[ ! -e "$workspace/slice-A/1-brief.md" ] || fail "slash ID created an output"

# --- review-package tests ---
review_package="$base/review-package"

# Exit 2 on bad ref
expect_exit 2 "$review_package" invalid-base HEAD slice-ids
expect_exit 2 "$review_package" HEAD invalid-head slice-ids

# Exit 3 on empty commit range (BASE == HEAD)
expect_exit 3 "$review_package" HEAD HEAD slice-ids

# Exit 3 on BASE not ancestor of HEAD
divergent=$(git commit-tree 'HEAD^{tree}' -m divergent)
expect_exit 3 "$review_package" "$divergent" HEAD slice-ids

# Commit a change so BASE..HEAD has at least 1 commit
echo "new change" >> "$workstream"
git commit -qam "second commit"
expect_exit 0 "$review_package" HEAD~1 HEAD slice-ids
[ -f "$workspace/review-$(git rev-parse --short HEAD~1)..$(git rev-parse --short HEAD).diff" ] || fail "review package diff missing"

# --- helpers survive a mode-stripping extractor dropping exec bits (#2040) ---
stripped="$tmp/stripped-scripts"
mkdir -p "$stripped"
cp "$base/wsd-workspace" "$base/slice-brief" "$base/review-package" "$stripped/"
chmod -x "$stripped"/*
noexec_out=$(bash "$stripped/slice-brief" "$workstream" A1) || fail "slice-brief failed when wsd-workspace lacked exec bit"
noexec_rev=$(bash "$stripped/review-package" HEAD~1 HEAD slice-ids) || fail "review-package failed when wsd-workspace lacked exec bit"

# --- Workspace identity and disambiguation ---
wsd_workspace="$base/wsd-workspace"

# 1. Ledger header written at create time
ws1="$tmp/repo/docs/workstreams/2026-01-01-feature.md"
cat > "$ws1" <<'EOF'
# Feature 1
### Slice A1: Feature 1 Slice
feat 1 body
EOF
git add docs/workstreams/2026-01-01-feature.md
git commit -qm "add feature 1"

dir1=$("$wsd_workspace" "$ws1")
[ -f "$dir1/progress.md" ] || fail "progress.md not created"
grep -q "Workstream: docs/workstreams/2026-01-01-feature.md" "$dir1/progress.md" || fail "ledger header missing or wrong in dir1"

# Same workstream resolves to the same workspace
dir1_again=$("$wsd_workspace" "$ws1")
[ "$dir1" = "$dir1_again" ] || fail "same workstream did not resolve to same workspace"

# 2. Colliding slug disambiguates and preserves original
ws2="$tmp/repo/docs/workstreams/2026-02-01-feature.md"
cat > "$ws2" <<'EOF'
# Feature 2
### Slice A1: Feature 2 Slice
feat 2 body
EOF
git add docs/workstreams/2026-02-01-feature.md
git commit -qm "add feature 2"

dir2=$("$wsd_workspace" "$ws2")
[ "$dir1" != "$dir2" ] || fail "colliding slug did not disambiguate"
grep -q "Workstream: docs/workstreams/2026-01-01-feature.md" "$dir1/progress.md" || fail "original ledger corrupted"
grep -q "Workstream: docs/workstreams/2026-02-01-feature.md" "$dir2/progress.md" || fail "new ledger header missing or wrong in dir2"

# Second call for second workstream returns same disambiguated workspace
dir2_again=$("$wsd_workspace" "$ws2")
[ "$dir2" = "$dir2_again" ] || fail "second call for second workstream did not return same disambiguated workspace"

# Direct two-arg form wsd-workspace SLUG WORKSTREAM_FILE
dir_two_arg=$("$wsd_workspace" feature "$ws2")
[ "$dir_two_arg" = "$dir2" ] || fail "direct two-arg form did not return disambiguated workspace"

# review-package after collision writes to the disambiguated workspace
echo "ws2 change" >> "$ws2"
git commit -qam "ws2 commit"
$review_package HEAD~1 HEAD feature "$ws2" >/dev/null
[ -f "$dir2/review-$(git rev-parse --short HEAD~1)..$(git rev-parse --short HEAD).diff" ] || fail "review-package did not write to disambiguated workspace"
[ ! -f "$dir1/review-$(git rev-parse --short HEAD~1)..$(git rev-parse --short HEAD).diff" ] || fail "review-package leaked into first workspace"

# 3. slice-brief creates briefs in distinct workspaces
$slice_brief "$ws1" A1 >/dev/null
$slice_brief "$ws2" A1 >/dev/null
[ -f "$dir1/slice-A1-brief.md" ] || fail "brief missing in dir1"
[ -f "$dir2/slice-A1-brief.md" ] || fail "brief missing in dir2"
grep -q "feat 1 body" "$dir1/slice-A1-brief.md" || fail "dir1 brief content mismatch"
grep -q "feat 2 body" "$dir2/slice-A1-brief.md" || fail "dir2 brief content mismatch"

# 4. -N counter fallback when workstream has no date prefix
mkdir -p "$tmp/repo/docs/workstreams/nodate"
ws_nd1="$tmp/repo/docs/workstreams/counter.md"
ws_nd2="$tmp/repo/docs/workstreams/nodate/counter.md"
printf '# ND1\n### Slice A: ND1\nnd1\n' > "$ws_nd1"
printf '# ND2\n### Slice A: ND2\nnd2\n' > "$ws_nd2"
git add "$ws_nd1" "$ws_nd2"
git commit -qm "add nodate workstreams"

dir_nd1=$("$wsd_workspace" "$ws_nd1")
dir_nd2=$("$wsd_workspace" "$ws_nd2")
[ "$dir_nd1" != "$dir_nd2" ] || fail "nodate workstreams collided"
[[ "$dir_nd1" == *"/counter" ]] || fail "first nodate workspace did not get bare slug (got $dir_nd1)"
[[ "$dir_nd2" == *"/counter-2" ]] || fail "second nodate workspace did not get -2 suffix (got $dir_nd2)"

# 5. Legacy headerless ledger adoption (including # Workstream: Payments, # Progress for x.md)
ws_legacy="$tmp/repo/docs/workstreams/2026-03-01-legacy.md"
cat > "$ws_legacy" <<'EOF'
# Legacy
### Slice A1: Legacy Slice
legacy
EOF
git add docs/workstreams/2026-03-01-legacy.md
git commit -qm "add legacy workstream"
mkdir -p "$tmp/repo/.solopowers/wsd/legacy"
printf "Slice A1: complete\n" > "$tmp/repo/.solopowers/wsd/legacy/progress.md"
warn_output=$("$wsd_workspace" "$ws_legacy" 2>&1 >/dev/null)
dir_legacy=$("$wsd_workspace" "$ws_legacy")
expected_legacy=$(cd "$tmp/repo/.solopowers/wsd/legacy" && pwd -P)
[ "$dir_legacy" = "$expected_legacy" ] || fail "legacy workspace not adopted (got $dir_legacy, expected $expected_legacy)"
[[ "$warn_output" == *"adopting legacy headerless ledger"* ]] || fail "legacy adoption warning missing on stderr"
grep -q "Workstream: docs/workstreams/2026-03-01-legacy.md" "$dir_legacy/progress.md" || fail "legacy ledger missing adopted header"
grep -q "Slice A1: complete" "$dir_legacy/progress.md" || fail "legacy ledger lost existing content"

# Non-.md value: # Workstream: Payments treated as legacy headerless, not a mismatch
mkdir -p "$tmp/repo/.solopowers/wsd/payments"
printf "# Workstream: Payments\nSlice A: complete\n" > "$tmp/repo/.solopowers/wsd/payments/progress.md"
ws_payments="$tmp/repo/docs/workstreams/payments.md"
printf '# Payments\n' > "$ws_payments"
git add "$ws_payments"
git commit -qm "add payments workstream"
dir_payments=$("$wsd_workspace" "$ws_payments" 2>/dev/null)
expected_payments=$(cd "$tmp/repo/.solopowers/wsd/payments" && pwd -P)
[ "$dir_payments" = "$expected_payments" ] || fail "Payments header was misidentified as mismatch instead of legacy"

# Non-matching prefix: # Progress for x.md treated as legacy headerless
mkdir -p "$tmp/repo/.solopowers/wsd/progress-test"
printf "# Progress for x.md\nSlice A: complete\n" > "$tmp/repo/.solopowers/wsd/progress-test/progress.md"
ws_ptest="$tmp/repo/docs/workstreams/progress-test.md"
printf '# Progress Test\n' > "$ws_ptest"
git add "$ws_ptest"
git commit -qm "add progress-test workstream"
dir_ptest=$("$wsd_workspace" "$ws_ptest" 2>/dev/null)
expected_ptest=$(cd "$tmp/repo/.solopowers/wsd/progress-test" && pwd -P)
[ "$dir_ptest" = "$expected_ptest" ] || fail "Progress for x.md was misidentified as mismatch instead of legacy"

# 6. CRLF and trailing whitespace in ledger header compared cleanly
ws_crlf="$tmp/repo/docs/workstreams/2026-04-01-crlf.md"
printf '# CRLF\n' > "$ws_crlf"
git add "$ws_crlf"
git commit -qm "add crlf workstream"
mkdir -p "$tmp/repo/.solopowers/wsd/crlf"
printf "# Workstream: docs/workstreams/2026-04-01-crlf.md   \r\n\n" > "$tmp/repo/.solopowers/wsd/crlf/progress.md"
dir_crlf=$("$wsd_workspace" "$ws_crlf" 2>/dev/null)
expected_crlf=$(cd "$tmp/repo/.solopowers/wsd/crlf" && pwd -P)
[ "$dir_crlf" = "$expected_crlf" ] || fail "CRLF header failed to match cleanly"

echo 'slice-brief tests passed'
