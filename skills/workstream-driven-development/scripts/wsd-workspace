#!/usr/bin/env bash
# Resolve and ensure the working-tree directory WSD uses for its short-lived
# artifacts: slice briefs, implementer reports, review packages, and the
# progress ledger. Print the directory's absolute path.
#
# The workspace lives in the working tree (not under .git/) because Claude Code
# treats .git/ as a protected path and denies agent writes there — which blocks
# an implementer subagent from writing its report file. A self-ignoring
# .gitignore keeps the workspace out of `git status` and out of accidental
# commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so slice-brief and
# review-package cannot drift to different directories. It is also the single
# source of truth for the slug: given only the workstream file (a name ending
# in .md or a path containing /), it derives one; any other bare name is a slug.
#
# Workstream layouts: a single file docs/workstreams/YYYY-MM-DD-<topic>.md
# names the workspace from its own basename. A folder workstream
# docs/workstreams/YYYY-MM-DD-<topic>/ passes its slices.md as the workstream
# file; because every folder has a file called slices.md, the slug and the date
# prefix come from the PARENT FOLDER name (date prefix stripped for the slug)
# instead of the basename.
#
# Slugs collide when two Workstream Documents share a slug (dropping the date
# prefix, e.g. 2026-01-01-auth.md vs 2026-02-01-auth.md, or the folders
# 2026-01-01-auth/ vs 2026-02-01-auth/), so each
# workspace records its owning Workstream Document's path in a ledger header
# at create time. A workspace owned by a different Workstream Document is
# skipped and the slug disambiguated (with the date prefix or counter) so stale
# ledgers are never reused.
#
# The repository is the current directory's (see wsd-repo), never the one the
# Workstream Document sits in: from a linked worktree, a document at an
# absolute path in the main checkout gets its workspace in the worktree, and
# the ledger header records that absolute path (a document outside the
# repository is identified by its absolute path, one inside by its
# repo-relative path). -C DIR runs as if started in DIR, the way git -C does,
# so a relative workstream_file resolves against DIR. Outside a git working
# tree the script exits 2.
#
# Usage: wsd-workspace [-C DIR] <slug_or_file> [workstream_file]
set -euo pipefail

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ "${1:-}" = "-C" ]; then
  [ -d "${2:-}" ] || { echo "bad -C directory: ${2:-}" >&2; exit 2; }
  cd "$2"
  shift 2
fi

if [ $# -lt 1 ] || [ $# -gt 2 ] || [ -z "$1" ]; then
  echo "usage: wsd-workspace [-C DIR] <slug_or_file> [workstream_file]" >&2
  exit 2
fi

# Two steps, so a failing wsd-repo stops the script instead of handing cd an
# empty path. Invoke via bash rather than direct exec: some extractors (Python
# zipfile) strip Unix exec bits when unpacking marketplace packages (#2040).
toplevel=$("${BASH:-bash}" "$here/wsd-repo")
root=$(CDPATH='' cd -- "$toplevel" && pwd -P)
base="$root/.solopowers/wsd"

# Name a workstream is known by: the file's basename without .md, or, for a
# folder workstream's slices.md, the parent folder's name.
ws_name() {
  local f="$1" parent
  if [ "$(basename -- "$f")" = "slices.md" ]; then
    parent=$(CDPATH='' cd -- "$(dirname -- "$f")" 2>/dev/null && pwd -P) || parent=""
    [ -n "$parent" ] && { basename -- "$parent"; return 0; }
  fi
  basename -- "$f" .md
}

workstream_file=""
slug=""

if [ $# -eq 2 ]; then
  if [[ "$1" == *.md || "$1" == */* ]]; then
    workstream_file=$1
    slug=$2
  else
    slug=$1
    workstream_file=$2
  fi
else
  if [[ "$1" == *.md || "$1" == */* ]]; then
    workstream_file=$1
    slug=$(ws_name "$workstream_file" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//')
  else
    slug=$1
  fi
fi

[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $1" >&2; exit 2; }

workstream_id=""
date_prefix=""
if [ -n "$workstream_file" ]; then
  [ -f "$workstream_file" ] || { echo "no such workstream file: $workstream_file" >&2; exit 2; }
  workstream_dir=$(CDPATH='' cd -- "$(dirname "$workstream_file")" && pwd -P)
  workstream_abs="$workstream_dir/$(basename "$workstream_file")"
  case "$workstream_abs" in
    "$root"/*) workstream_id=${workstream_abs#"$root"/} ;;
    *)         workstream_id=$workstream_abs ;;
  esac
  date_prefix=$(ws_name "$workstream_file" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}' || true)
fi

owns() {
  local target="$1"
  local ledger="$target/progress.md"
  if [ -z "$workstream_id" ]; then
    mkdir -p "$target"
    [ -e "$target/.gitignore" ] || printf '*\n' > "$target/.gitignore"
    return 0
  fi

  if [ -f "$ledger" ]; then
    local first_line
    first_line=$(head -n1 "$ledger" | tr -d '\r' | sed -E 's/[[:space:]]+$//')
    if [[ "$first_line" =~ ^#\ Workstream:\ (.*\.md)$ ]]; then
      local header="${BASH_REMATCH[1]}"
      header=$(printf '%s' "$header" | sed -E 's/[[:space:]]+$//')
      [ "$header" = "$workstream_id" ]
    else
      # Legacy headerless ledger (no header or not matching ^# Workstream: ...\.md)
      echo "warning: adopting legacy headerless ledger at $ledger for $workstream_id" >&2
      local existing
      existing=$(cat "$ledger")
      printf '# Workstream: %s\n\n%s\n' "$workstream_id" "$existing" > "$ledger"
      return 0
    fi
  else
    mkdir -p "$target"
    [ -e "$target/.gitignore" ] || printf '*\n' > "$target/.gitignore"
    printf '# Workstream: %s\n\n' "$workstream_id" > "$ledger"
    return 0
  fi
}

dir="$base/$slug"
if ! owns "$dir"; then
  if [ -n "$date_prefix" ]; then
    candidate="$base/$slug-$date_prefix"
    if owns "$candidate"; then
      dir="$candidate"
    else
      n=2
      while ! owns "$base/$slug-$date_prefix-$n"; do n=$((n + 1)); done
      dir="$base/$slug-$date_prefix-$n"
    fi
  else
    n=2
    while ! owns "$base/$slug-$n"; do n=$((n + 1)); done
    dir="$base/$slug-$n"
  fi
fi

mkdir -p "$dir"
[ -e "$dir/.gitignore" ] || printf '*\n' > "$dir/.gitignore"
[ -e "$base/.gitignore" ] || printf '*\n' > "$base/.gitignore"

# On Windows (Git Bash, MSYS2, Cygwin) print C:/Users/... rather than
# /c/Users/...: the caller may be PowerShell or another native tool, which
# can't resolve MSYS paths, and bash accepts this form too. Only the printed
# path changes; the ledger-header markers above keep pwd -P's spelling, so
# existing workspaces still match their documents.
CDPATH='' cd -- "$dir"
if command -v cygpath >/dev/null 2>&1; then cygpath -m "$PWD"; else pwd; fi
