#!/usr/bin/env bash
# Print the top-level directory of the git working tree the WSD scripts use:
# the current directory's, exactly as git itself picks one. A caller that
# means a different working tree says so with the scripts' -C DIR, which
# they apply (cd) before calling this.
#
# The Workstream Document's location never picks the repository. An agent
# working in a linked worktree commonly holds an absolute path to a document
# that lives in the main checkout, and its workspace and commits belong to the
# worktree it is working in. And a caller standing outside any repository,
# such as the skill's own directory in an installed plugin, is in the wrong
# place: guessing a repository from the document would silently act on
# whichever checkout the path points into.
#
# Outside any working tree, stop. --with-commit also stops on a repository
# with no commit yet, for callers that need HEAD as a BASE or a review
# range. The message covers both ways to get here: running from the wrong
# directory (where 'git init' would be the wrong fix) and a new project
# that has no repository or commit yet.
#
# Single source of truth for which repository the WSD scripts work in, so no
# two of them can disagree.
#
# Usage: wsd-repo [--with-commit]
# Exit codes: 0 success (top-level printed); 2 no working tree, no commit
# when --with-commit, or invalid usage.
set -euo pipefail

with_commit=false
if [ "${1:-}" = "--with-commit" ]; then
  with_commit=true
  shift
fi

if [ $# -ne 0 ]; then
  echo "usage: wsd-repo [--with-commit]" >&2
  exit 2
fi

if root=$(git rev-parse --show-toplevel 2>/dev/null); then
  if [ "$with_commit" = false ] || git -C "$root" rev-parse --verify --quiet HEAD >/dev/null; then
    printf '%s\n' "$root"
    exit 0
  fi
  said=$(git -C "$root" rev-parse --verify HEAD 2>&1 >/dev/null) || true
else
  said=$(git rev-parse --show-toplevel 2>&1 >/dev/null) || true
fi

# git's own first line always follows the shared message: where git refuses
# a working tree the caller is inside (dubious ownership, git missing from
# PATH, the cwd inside .git), the shared message alone would be wrong, and
# git's line names the real fix.
echo "WSD scripts must run from inside the git working tree you're executing in, with at least one commit when a review range is needed (current directory: $PWD). If this is a new project, run 'git init' and make a first commit, then rerun." >&2
echo "git said: ${said%%$'\n'*}" >&2
exit 2
